# Database. Local development uses docker compose (see docker-compose.yml):
#   docker compose up -d
DATABASE_URL="postgresql://mrdesign:mrdesign@localhost:5434/mrdesign"

# Public site URL, used for metadata and sitemap.
SITE_URL="http://localhost:3000"

# Integration and e2e tests create and delete rows, so they only run against a local database.

# Admin authentication (better-auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Contact notifications and password reset emails (Brevo). Server-only: never prefix with NEXT_PUBLIC_.
# Without a key, messages are still stored but no email is sent.
BREVO_API_KEY=""
CONTACT_NOTIFY_EMAIL="contacto@mrdesign.com.co"
CONTACT_SENDER_EMAIL="noreply@mrdesign.com.co"

# Media library on Cloudflare R2 (dashboard /admin/imagenes). Server-only: never prefix with NEXT_PUBLIC_.
# The API token needs Object Read & Write on this bucket only. The bucket's CORS must allow PUT from the
# site origin with the content-type and x-amz-checksum-sha256 headers (the browser uploads directly).
# R2_PUBLIC_URL is the bucket's public base URL (custom domain), without a trailing slash. Set it at
# build time too: next.config.ts derives the next/image allowlist from it. Without these, the library
# shows a "not configured" notice and uploads stay disabled.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
# Test-only: the e2e suite points R2_ENDPOINT at the local fake bucket (e2e/fake-r2.mjs). Leave it unset.
# Only a loopback address (localhost, 127.0.0.1, [::1]) is accepted; any other value is ignored with a
# warning and the app uses https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
# R2_ENDPOINT=""
