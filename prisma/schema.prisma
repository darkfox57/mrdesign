generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Translatable content uses one row per locale. Rows that are versions of the
// same content share a translationKey, which drives hreflang and the language switcher.

enum Locale {
  es
  en
}

model ContactSubmission {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  // A service id from src/content/services.ts, or "other".
  projectType String
  message     String
  consent     Boolean
  locale      Locale
  // Set when someone marks the message as read in the dashboard inbox; null means unread.
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

// better-auth tables (email and password, admin plugin).
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}


// Images uploaded from the dashboard to Cloudflare R2 (src/lib/media). The object key and the
// row come from the content hash, so the same image is stored once.
model MediaFile {
  id           String   @id @default(cuid())
  sha256       String   @unique
  key          String   @unique
  url          String
  contentType  String
  size         Int
  originalName String
  // Required before an image is used on the site; empty until someone writes it.
  alt          String   @default("")
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Blog: one row per locale; versions of the same post share a translationKey.
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostSource {
  MANUAL
  API
}

model Author {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  bio       String?
  avatarUrl String?
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id             String   @id @default(cuid())
  locale         Locale
  translationKey String   @default(cuid())
  name           String
  slug           String
  description    String?
  posts          Post[]
  createdAt      DateTime @default(now())

  @@unique([locale, slug])
  @@unique([locale, name])
  @@unique([translationKey, locale])
}

model Tag {
  id             String   @id @default(cuid())
  locale         Locale
  translationKey String   @default(cuid())
  name           String
  slug           String
  posts          Post[]
  createdAt      DateTime @default(now())

  @@unique([locale, slug])
  @@unique([locale, name])
  @@unique([translationKey, locale])
}

model Post {
  id             String        @id @default(cuid())
  locale         Locale
  translationKey String        @default(cuid())
  title          String
  slug           String
  excerpt        String
  // Sanitized HTML. Never store unsanitized input here.
  content        String
  coverImageUrl  String?
  coverImageAlt  String?
  status         ContentStatus @default(DRAFT)
  source         PostSource    @default(MANUAL)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  authorId       String?
  author         Author?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categories     Category[]
  tags           Tag[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([locale, slug])
  @@unique([translationKey, locale])
  @@index([locale, status, publishedAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  // SHA-256 of the key; the plain key is shown once and never stored.
  keyHash    String    @unique
  prefix     String
  // What the ingest API does with the posts this key sends: publish them or leave them as drafts.
  publishImmediately Boolean @default(true)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}


// Landing pages built with the visual builder (Puck). One row per locale; versions share a translationKey.
model Landing {
  id             String        @id @default(cuid())
  locale         Locale
  translationKey String        @default(cuid())
  slug           String
  // Internal name shown in the dashboard; the page's visible text lives in the blocks.
  title          String
  // Visual builder page: what the public page shows. Validated by src/lib/visual-builder/validate.ts.
  blocks         Json?
  // The builder's unpublished draft; publishing copies it to blocks.
  draftBlocks    Json?
  seoTitle       String?
  seoDescription String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([locale, slug])
  @@unique([translationKey, locale])
  @@index([locale, status])
}

// Login and password-reset throttling (src/lib/auth/login-rate-limit.ts). One row per counted key,
// namespaced like "login:acct:<email>" or "reset:ip:<address>". Rows live in the database so locks
// survive restarts, work across instances and are never evicted by other keys.
// Writes go through one atomic upsert per key; expired rows are deleted opportunistically.
model AuthThrottle {
  key         String    @id
  // Failures counted in the current fixed window, which starts at its first failure.
  failures    Int
  windowStart DateTime  @db.Timestamptz(3)
  // Set once failures reach the key's limit: attempts are refused until then (end of the window).
  lockedUntil DateTime? @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([windowStart])
}
